<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- 1. Configure NuGet Package generation and XML Documentation -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
        
    <!-- 2. NuGet Package Metadata Info -->
    <PackageId>ArrangeAlgorithms</PackageId>
    <Version>1.0.3</Version>
    <Authors>Nguyen Thang</Authors>
    <Company>Nguyen Thang</Company>
    <Description>A 2D label placement library for engineering drawings that automatically arranges labels to prevent overlaps with each other and blocked regions. Features 5 layout algorithms: Greedy, Bounded Backtracking, Simulated Annealing, Force-Directed, and Constraint Satisfaction.</Description>
    <PackageProjectUrl>https://github.com/nguyenthanguth/ArrangeAlgorithms</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nguyenthanguth/ArrangeAlgorithms</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Copyright>Copyright © 2026 Nguyen Thang</Copyright>
    <PackageTags>label-placement geometry cad autocad tekla algorithm greedy backtracking simulated-annealing force-directed csp</PackageTags>
    <PackageReleaseNotes>
      - Fixed backup state issue (null preservation for BlockPolygons and BlockLines) in the 2-pass relaxation algorithm.
      - Added comprehensive XML documentation comments across all geometric types (GeoPoint, GeoLine, GeoPolygon, GeoRectangle, GeoVector, and Tolerance) to resolve compilation warning CS1591.
      - Updated CAD and Tekla test runners to target x64 platform explicitly to prevent architecture mismatch warnings (MSB3270).
      - Configured NuGet metadata with Copyright and PackageTags.
      - Added package icon according to Microsoft best practices.
    </PackageReleaseNotes>

    <!-- 3. Embed source code and Debug symbols into DLL to support F12 original code viewing -->
    <DebugType>embedded</DebugType>
    <EmbedAllSources>true</EmbedAllSources>
    <GenerateDependencyFile>false</GenerateDependencyFile>

  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>